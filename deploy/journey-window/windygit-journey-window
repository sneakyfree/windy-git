#!/usr/bin/env python3
"""Journey window (Boss order 11-04 23:44Z, narrowed 00:30Z): Veron's general runners (veron-1, veron-1-2, veron-1-3) take
NO new jobs from :17 to :40 UTC every hour (J1), extended to :50 in the hours J3 runs (15, 19, 23 UTC) and in any hour
listed one per line in /etc/windygit/journey-window.hours (Word's shadow slots). Running jobs finish. Null 0, the canary
and the userns runner are untouched.

Throttle (Boss 02:13Z, until the journey VMs move to Windy 0): outside the window only ONE general runner (the lowest
id, veron-1) stays active at all hours; the other two are held with the same label swap. Null 0 / Windy 0 carry the rest.
Change KEEP_ACTIVE below to widen it. The OFF file or `restore` puts everything back.

Mechanism: Gitea matches a waiting job to a runner by the runner's agent_labels (read from the DB on every fetch). In the
window the three rows get the label list ["journey-window"], which no job asks for, so they fetch nothing; the originals are
saved in STATE and put back when the window ends (or any minute outside the window, or when OFF exists). Run every minute by
windygit-journey-window.timer as root. Idempotent: a runner that restarts and re-declares its labels in the window is paused
again within a minute.

  windygit-journey-window            decide by the clock
  windygit-journey-window restore    put the labels back now
"""
import json
import os
import subprocess
import sys
import time

STATE = os.environ.get("JW_STATE", "/var/lib/windygit/journey-window.json")
OFF = os.environ.get("JW_OFF", "/etc/windygit/journey-window.off")
NAMES = ("veron-1", "veron-1-2", "veron-1-3")
PAUSED = '["journey-window"]'
HOURS_FILE = os.environ.get("JW_HOURS", "/etc/windygit/journey-window.hours")
KEEP_ACTIVE = 1  # general runners left active outside the window
START, END, END_LONG = 17, 40, 50  # minutes past the hour, UTC: paused while START <= minute < END (END_LONG in long hours)
LONG_HOURS = {15, 19, 23}  # J3 hours (:30 run)


def extra_hours() -> set[int]:
    try:
        return {int(x) for x in open(HOURS_FILE).read().split() if x.strip().isdigit() and 0 <= int(x) <= 23}
    except OSError:
        return set()


def psql(sql: str) -> list[list[str]]:
    out = subprocess.run(["docker", "exec", "-i", "windy-git-db-1", "sh", "-c",
                          'psql -U "$POSTGRES_USER" -d gitea -At -F "|" -v ON_ERROR_STOP=1'],
                         input=sql, capture_output=True, text=True, check=True, timeout=60).stdout.strip()
    return [line.split("|", 2) for line in out.splitlines() if line and "|" in line]


def in_window(minute: int, hour: int = 0) -> bool:
    long = hour in LONG_HOURS or hour in extra_hours()
    return START <= minute < (END_LONG if long else END)


def load() -> dict:
    try:
        d = json.load(open(STATE))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save(d: dict) -> None:
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.replace(tmp, STATE)


def general_runners(query=psql) -> list[list[str]]:
    names = ",".join(f"'{n}'" for n in NAMES)
    return query("select id, name, agent_labels from action_runner where coalesce(deleted, 0) = 0 and repo_id = 0 "
                 f"and name in ({names}) and last_online > extract(epoch from now())::bigint - 900 order by id;")


def pause(query=psql, hold: int = 0) -> str:
    """Hold every general runner except the first `hold` (by id); give the held-back `hold` their labels back."""
    saved = load()
    rows = general_runners(query)
    n = 0
    for i, (rid, name, labels) in enumerate(rows):
        if not rid.isdigit():
            continue
        if i < hold:  # keeper: restore if we had paused it
            if rid in saved:
                query(f"update action_runner set agent_labels = '{saved[rid].replace(chr(39), '')}' "
                      f"where id = {int(rid)} and agent_labels = '{PAUSED}';")
                del saved[rid]
            continue
        if labels != PAUSED:
            saved[rid] = labels  # the real list (re-declared after a restart too)
            query(f"update action_runner set agent_labels = '{PAUSED}' where id = {int(rid)};")
            n += 1
    save(saved)
    return f"{'window OPEN' if hold == 0 else 'throttle'}: {n} newly paused, {len(saved)} runner(s) held ({', '.join(sorted(saved))})"


def restore(query=psql) -> str:
    saved = load()
    for rid, labels in saved.items():
        if not rid.isdigit():
            continue
        # only put back what we paused: a runner that already re-declared its own labels keeps them
        query(f"update action_runner set agent_labels = '{labels.replace(chr(39), '')}' "
              f"where id = {int(rid)} and agent_labels = '{PAUSED}';")
    save({})
    return f"CLOSED: {len(saved)} runner(s) restored"


def main(argv, now=time.gmtime, query=psql) -> int:
    if (argv[1:2] == ["restore"]) or os.path.exists(OFF):
        if load():
            print(restore(query))
        return 0
    t = now()
    print(pause(query, hold=0 if in_window(t.tm_min, t.tm_hour) else KEEP_ACTIVE))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
