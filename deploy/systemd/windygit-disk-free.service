[Unit]
Description=Veron free disk in Windy Git's uptime beat; under 10% free = WARN to Boss (reads only)

[Service]
Type=oneshot
# windy-job: a heartbeat windy-uptime checks; "disk: ok" missing = an alert carrying the WARN line.
ExecStart=/usr/local/bin/windy-job windygit-disk-free 2h30m --expect "^disk: ok$" --owner 13 -- /usr/bin/python3 /srv/windygit/src/scripts/disk_free.py
TimeoutStartSec=60
Nice=10
