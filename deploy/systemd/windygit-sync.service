[Unit]
Description=Sync GitHub -> Windy Git (Phase 1: GitHub is the source of truth)
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/windygit/src
# Only what the sync uses: GITEA_SYNC_TOKEN (write:repository) + GITHUB_TOKEN, root 0600.
# NOT the api .env: the sync never sees the admin token, R2 or DB secrets.
EnvironmentFile=/etc/windygit/sync.env
# Both tokens live only in that file on the host — NEVER commit them.
Environment=GITHUB_OWNER=sneakyfree
ExecStart=/bin/bash /srv/windygit/src/scripts/sync_from_github.sh
Nice=10
